<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>uy.edu.utec</groupId>
    <artifactId>ServidorWeb</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <name>ServidorWeb</name>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>
    </properties>

    <dependencies>
        
        <!--Metro: API para consumir servicio SOAP publicada por central-->
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.5</version>
        </dependency>

        <!-- iText 5: generación dinámica del PDF del acta (Requerimiento Especial 7.4) -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>

        <!-- Servlet API (provisto por Tomcat en tiempo de ejecución) -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSP API -->
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.3</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>

                <executions>
                    <execution>
                        <id>actualizar-contrato-central</id>
                        <phase>initialize</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>
                            <executable>${java.home}/bin/java</executable>

                            <arguments>
                                <argument>${project.basedir}/../herramientas/ActualizarContrato.java</argument>
                                <argument>--automatico</argument>
                                <argument>${project.basedir}/src/main/resources/wsdl</argument>
                                <argument>${project.build.directory}/jaxws/stale</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
           
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            
            <plugin>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>4.0.5</version>

                <executions>
                    <execution>
                        <id>generar-cliente-central</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>wsimport</goal>
                        </goals>
                    </execution>
                </executions>

                <configuration>
                    <wsdlDirectory>
                        ${project.basedir}/src/main/resources/wsdl
                    </wsdlDirectory>

                    <wsdlFiles>
                        <wsdlFile>central.wsdl</wsdlFile>
                    </wsdlFiles>

                    <packageName>cliente.central</packageName>
                    <wsdlLocation>/wsdl/central.wsdl</wsdlLocation>

                    <keep>true</keep>
                    <xnocompile>true</xnocompile>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <warSourceDirectory>web</warSourceDirectory>
                    <packagingExcludes>WEB-INF/lib/ServidorCentral.jar,WEB-INF/lib/eclipselink*.jar,WEB-INF/lib/*persistence*.jar,WEB-INF/lib/mariadb-java-client*.jar,WEB-INF/classes/META-INF/persistence.xml</packagingExcludes>
                    <webXml>web/WEB-INF/web.xml</webXml>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>